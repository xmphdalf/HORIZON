<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:background="@drawable/widget_bg">
<ImageView android:id="@+id/arc" android:layout_width="28dp" android:layout_height="24dp" android:importantForAccessibility="no" android:contentDescription="@null" android:scaleType="fitCenter"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="5dp" android:orientation="vertical">
    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="20sp"
        android:textColor="#E0C29B"
        android:singleLine="true"
        />
    <TextView
        android:id="@+id/detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="#BAA58D"
        android:singleLine="true"
        android:ellipsize="end"
        />
</LinearLayout>
    <TextView
        android:id="@+id/less"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textSize="20sp"
        android:textColor="#E5D2BC"
        android:text="@string/less"
        android:contentDescription="@string/decrease"
        android:background="@drawable/widget_key"
        android:layout_marginEnd="3dp"
        />
    <TextView
        android:id="@+id/more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textSize="20sp"
        android:textColor="#E5D2BC"
        android:text="@string/more"
        android:contentDescription="@string/increase"
        android:background="@drawable/widget_key"
        android:layout_marginEnd="3dp"
        />
    <TextView
        android:id="@+id/power"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#191410"
        android:background="@drawable/widget_escape"
        />
</LinearLayout>
