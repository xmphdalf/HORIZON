<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="#E9ECEE"
        android:paddingBottom="4dp"
        />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView
        android:id="@+id/stop"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#191410"
        android:layout_weight="1.5"
        android:text="@string/turn_off_now"
        android:background="@drawable/escape_key"
        />
    <TextView
        android:id="@+id/less"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#E5D2BC"
        android:layout_weight="0.65"
        android:text="@string/less"
        android:contentDescription="@string/less_brightness"
        />
    <TextView
        android:id="@+id/more"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#E5D2BC"
        android:layout_weight="0.65"
        android:text="@string/more"
        android:contentDescription="@string/more_brightness"
        />
    <TextView
        android:id="@+id/pause"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#E5D2BC"
        android:layout_weight="1.2"
        android:text="@string/pause"
        />
</LinearLayout>
</LinearLayout>
