<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="15sp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:paddingBottom="8dp"
        />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView
        android:id="@+id/stop"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="2dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#191410"
        android:layout_weight="1.15"
        android:text="@string/turn_off_now"
        android:background="@drawable/control_off"
        />
    <TextView
        android:id="@+id/less"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="2dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:layout_weight="1"
        android:text="@string/less"
        android:contentDescription="@string/less_brightness"
        />
    <TextView
        android:id="@+id/more"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="2dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:layout_weight="1"
        android:text="@string/more"
        android:contentDescription="@string/more_brightness"
        />
    <TextView
        android:id="@+id/pause"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="2dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:layout_weight="1.2"
        android:text="@string/pause"
        />
</LinearLayout>
</LinearLayout>
